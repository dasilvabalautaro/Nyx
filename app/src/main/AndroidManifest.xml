<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse (no dataSync): Android 15 corta los FGS dataSync a las 6 h; una conexión
         de mensajería persistente es justo el caso que specialUse contempla, y además puede
         arrancarse desde BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 7d: en llamada el FGS añade el tipo microphone (mantiene el micro con la pantalla
         apagada por proximidad y sube la prioridad del proceso). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- registerDefaultNetworkCallback (reconexión rápida WiFi↔datos en el FGS) lo requiere. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exención de Doze: sin ella el sistema congela el bucle WAN al apagar la pantalla. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WifiLock (mantener el WiFi despierto en segundo plano) requiere WAKE_LOCK. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Cámara: solo para escanear el QR de verificación de identidad (anti-MITM). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Micrófono: notas de voz y llamadas (se pide en tiempo de ejecución al usarlo). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Llamadas: alternar altavoz/auricular y modo de comunicación. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bloqueo de acceso a la app: BiometricPrompt (huella/cara/PIN del sistema). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Vibración en bucle mientras suena una llamada entrante (en silencio no hay timbre). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Llamada entrante a pantalla completa con el móvil bloqueado. En Android 14+ se
         concede automáticamente a las apps de llamadas (la notificación es CATEGORY_CALL con
         CallStyle); sin esto solo salía un aviso discreto en la bandeja. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Sin copia automática de Google: los datos de la app son la identidad Ed25519
         (nyx_identity.xml), la base de mensajes y los adjuntos. Con allowBackup="true"
         (el valor de la plantilla) todo eso acababa en el Drive del usuario, fuera del E2EE
         y en contradicción con la §7 de la política de privacidad, que promete que la única
         copia es el .krbk cifrado con la frase-clave del usuario. Las reglas XML quedan como
         defensa en profundidad por si alguien reactiva la bandera. -->
    <application
        android:name=".NyxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Nyx">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Nyx"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mantiene el nodo libp2p + wake vivos con la app cerrada (Fase 5). -->
        <service
            android:name=".NyxForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Conexión P2P persistente (libp2p) para recibir mensajes E2EE sin servidores de push de terceros" />
        </service>

        <!-- Rearma el servicio tras un reinicio del móvil. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Latido de entrega (AlarmManager) para móviles que suspenden la red en 2.º plano. -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:exported="false" />

        <!-- Contestar/rechazar desde la notificación de llamada entrante. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="chat.neto.nyx.CALL_ANSWER" />
                <action android:name="chat.neto.nyx.CALL_DECLINE" />
            </intent-filter>
        </receiver>

        <!-- Para abrir archivos recibidos con otra app (visor de PDF, etc.) sin exponer rutas. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>