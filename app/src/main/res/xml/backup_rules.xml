<?xml version="1.0" encoding="utf-8"?><!--
   Copia automática en API <= 30. Nyx la desactiva del todo con allowBackup="false";
   estas exclusiones son defensa en profundidad por si la bandera se reactivara: nada de la
   app debe salir del dispositivo por esta vía (la identidad Ed25519 está en sharedpref, los
   mensajes en database y los adjuntos en file). La copia legítima es la exportación .krbk,
   cifrada con la frase-clave del usuario.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
